{
  "name": "@pagopa/it-wallet-conformance-tool",
  "description": "Automated conformance testing for IT Wallet ecosystem services",
  "repository": {
    "url": "https://github.com/pagopa/wallet-conformance-test",
    "type": "git"
  },
  "packageManager": "pnpm@10.23.0",
  "version": "1.2.1",
  "type": "module",
  "main": "./dist/cli.js",
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "bin",
    "config.example.ini",
    "dist",
    "docs",
    "dumps",
    "vitest.common.js",
    "vitest.issuance.config.js",
    "vitest.presentation.config.js"
  ],
  "bin": {
    "wct": "bin/wct"
  },
  "scripts": {
    "build": "node scripts/build.ts --production",
    "ta:server": "tsx src/servers/ta-server.ts",
    "wp:server": "tsx src/servers/wp-server.ts",
    "ci:server": "tsx src/servers/ci-server.ts",
    "servers": "concurrently \"pnpm ta:server\" \"pnpm wp:server\" \"pnpm ci:server\"",
    "types:check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "test:unit": "vitest --config vitest.unit.config.js",
    "format": "prettier --write \"{src,tests}/**/*.{js,ts}\"",
    "format:check": "prettier --check \"{src,tests}/**/*.{js,ts}\"",
    "lint": "eslint --fix \"{src,tests}/**/*.{js,ts}\"",
    "lint:check": "eslint \"{src,tests}/**/*.{js,ts}\"",
    "pre-commit": "pnpm format && pnpm lint && pnpm types:check",
    "prepare": "husky",
    "code-review": "pnpm types:check && pnpm lint:check && pnpm format:check && pnpm -r build",
    "test:issuance": "vitest run --config vitest.issuance.config.js",
    "test:issuance:ui": "vitest --config vitest.issuance.config.js --ui",
    "test:presentation": "vitest run --config vitest.presentation.config.js",
    "prepack": "pnpm build"
  },
  "keywords": [
    "wallet",
    "conformance",
    "testing",
    "tool",
    "cli"
  ],
  "author": "PagoPa S.p.A.",
  "license": "ISC",
  "devDependencies": {
    "@pagopa/eslint-config": "^5.0.1",
    "@types/express": "^5.0.3",
    "@types/ini": "^4.1.1",
    "@types/node": "^24.1.0",
    "@vitest/ui": "^3.2.4",
    "concurrently": "^9.2.1",
    "esbuild": "^0.28.0",
    "eslint": "^10.9.0",
    "husky": "^9.1.7",
    "prettier": "^3.6.2",
    "tsx": "^4.22.3",
    "typescript": "^5.8.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "puppeteer"
    ],
    "overrides": {
      "qs@>=6.11.1 <=6.15.1": ">=6.15.2",
      "brace-expansion@>=5.0.0 <5.0.6": ">=5.0.6",
      "shell-quote@>=1.1.0 <=1.8.3": ">=1.8.4",
      "esbuild@>=0.27.3 <0.28.1": ">=0.28.1",
      "js-yaml@>=4.0.0 <=4.1.1": ">=4.2.0",
      "brace-expansion@<1.1.16": ">=1.1.16",
      "brace-expansion@>=3.0.0 <5.0.7": ">=5.0.7",
      "js-yaml@>=4.0.0 <4.3.0": ">=4.3.0",
      "shell-quote@<=1.8.4": ">=1.9.0",
      "body-parser@>=2.0.0 <2.3.0": ">=2.3.0",
      "valibot@<=1.4.1": ">=1.4.2",
      "brace-expansion@<1.1.17": ">=1.1.17",
      "brace-expansion@>=4.0.0 <5.0.8": ">=5.0.8",
      "postcss@<=8.5.22": ">=8.5.23",
      "brace-expansion@>=4.0.0 <5.0.9": ">=5.0.9",
      "brace-expansion@<1.1.18": ">=1.1.18",
      "js-yaml@>=4.0.0 <4.3.1": ">=4.3.1",
      "nanoid@<3.3.16": ">=3.3.16",
      "nanoid@<3.3.18": ">=3.3.18",
      "postcss@<=8.5.17": ">=8.5.18"
    }
  },
  "dependencies": {
    "@owf/mdoc": "^0.7.0",
    "@pagopa/io-wallet-oauth2": "1.5.5",
    "@pagopa/io-wallet-oid-federation": "1.5.5",
    "@pagopa/io-wallet-oid4vci": "1.5.5",
    "@pagopa/io-wallet-oid4vp": "1.5.5",
    "@pagopa/io-wallet-utils": "1.5.5",
    "@peculiar/x509": "^1.14.3",
    "@sd-jwt/core": "^0.17.0",
    "@sd-jwt/crypto-nodejs": "^0.17.0",
    "@sd-jwt/decode": "^0.17.0",
    "@sd-jwt/jwt-status-list": "^0.19.0",
    "@sd-jwt/sd-jwt-vc": "^0.17.1",
    "@sd-jwt/types": "^0.17.0",
    "cbor": "^10.0.11",
    "commander": "^14.0.2",
    "consola": "^3.4.2",
    "dcql": "^3.0.0",
    "express": "^5.2.1",
    "ini": "^5.0.0",
    "jose": "^6.1.0",
    "puppeteer": "^25.1.0",
    "vitest": "^3.2.4",
    "zod": "^4.4.3"
  }
}
